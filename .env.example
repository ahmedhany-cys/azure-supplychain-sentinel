# Copy to .env (git-ignored). Placeholders only - never commit real values.

# Where analysis history (SQLite) and local keys live. Default: ./.sentinel
SENTINEL_DATA_DIR=.sentinel
# Directories the API/dashboard may analyse (os.pathsep-separated). Default: ./examples
SENTINEL_ALLOWED_ROOTS=./examples
# Active release policy. Default: config/policy.default.yaml
SENTINEL_POLICY=config/policy.default.yaml
# Optional bearer token required by the REST API (leave empty for local-only use)
SENTINEL_API_TOKEN=
# External tools: "auto" uses them when installed, "off" forces the native fallback
SENTINEL_USE_SYFT=auto
SENTINEL_USE_COSIGN=auto
SENTINEL_OSV_TIMEOUT=120
SENTINEL_MAX_UPLOAD_MB=50
# Password protecting locally generated development signing keys (sentinel keygen)
SENTINEL_SIGNING_PASSWORD=change-me-locally
